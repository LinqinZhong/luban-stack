      "dataConfig": {
        "source": "mysql",
        "operation": "custom",
        "queryFields": [],
        "sql": "SELECT\n  COUNT(id) AS total,\n  COALESCE(SUM(CASE WHEN score >= 8 THEN 1 ELSE 0 END), 0) AS good,\n  COALESCE(SUM(CASE WHEN score >= 5 AND score < 8 THEN 1 ELSE 0 END), 0) AS mid,\n  COALESCE(SUM(CASE WHEN score < 5 THEN 1 ELSE 0 END), 0) AS bad\nFROM {TABLE_NAME}\nWHERE is_deleted = 0\n  AND goods_id = #{goodsId}",
        "fieldMappings": [
          {
            "field": "total",
            "column": "total"
          },
          {
            "field": "good",
            "column": "good"
          },
          {
            "field": "mid",
            "column": "mid"
          },
          {
            "field": "bad",
            "column": "bad"
          }
