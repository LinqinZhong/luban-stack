      <RelativeLayout width="{item.halfSize}" height="match_parent" onClick="[{&quot;id&quot;:&quot;bind_starrate_right&quot;,&quot;method&quot;:&quot;updateProps&quot;,&quot;args&quot;:{&quot;prop&quot;:&quot;value&quot;,&quot;value&quot;:&quot;{item.rightValue}&quot;}},{&quot;id&quot;:&quot;bind_starrate_right_emit&quot;,&quot;method&quot;:&quot;emit&quot;,&quot;args&quot;:{&quot;event&quot;:&quot;change&quot;,&quot;value&quot;:&quot;{item.rightValue}&quot;}}]"/>
