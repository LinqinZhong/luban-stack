    <LinearLayout orientation="horizontal" width="match_parent" height="match_parent" layout_alignParentLeft="true" layout_alignParentTop="true" layout_alignParentRight="true" layout_alignParentBottom="true" vIf="{&quot;scenarios&quot;:[{&quot;id&quot;:&quot;scene_starrate_edit&quot;,&quot;name&quot;:&quot;编辑&quot;,&quot;conditions&quot;:[{&quot;field&quot;:&quot;$props.readonly&quot;,&quot;op&quot;:&quot;eq&quot;,&quot;value&quot;:&quot;false&quot;}]}]}">
