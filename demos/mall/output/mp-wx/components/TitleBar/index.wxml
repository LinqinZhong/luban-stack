<view style="width:100%;height:auto;padding:0rpx;display:flex;flex-direction:column">
  <view style="width:100%;height:{{height}}px;padding:0rpx;padding-top:{{offsetTop}}px;background:{{background}};position:relative;box-sizing:border-box">
    <view style="position:relative;width:100%;height:100%;min-height:0;box-sizing:border-box">
      <image wx:if="{{showBack}}" catchtap="__onTap_0" src="/assets/icons/back.svg" mode="aspectFit" style="width:auto;height:auto;color:{{color}};font-size:40rpx;position:absolute;top:50%;left:20rpx;-webkit-transform:translateY(-50%);transform:translateY(-50%);width:40rpx;height:40rpx" />
      <text style="width:auto;height:auto;color:{{color}};font-size:28rpx;position:absolute;left:50%;top:50%;-webkit-transform:translate(-50%,-50%);transform:translate(-50%,-50%)">{{title}}</text>
    </view>
  </view>
</view>
