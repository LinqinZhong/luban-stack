<view style="width:100%;height:100%;background:#ededed;display:flex;flex-direction:column">
  <title-bar title="聊天" style="width:100%;height:auto" />
  <view style="width:100%;flex:1;min-height:0;height:0;padding:0rpx;position:relative;box-sizing:border-box">
    <view style="position:relative;width:100%;height:100%;min-height:0;box-sizing:border-box">
      <view style="width:100%;height:80rpx;padding:0rpx;padding-left:20rpx;padding-right:20rpx;background:#ffffff;position:absolute;bottom:0;display:flex;flex-direction:row;align-items:center;justify-content:center">
        <input value="{{content}}" placeholder="请输入消息" style="flex:1;min-width:0;width:0;height:60rpx;padding-left:24rpx;padding-right:24rpx;background:#ffffff;border-radius:8rpx;color:#303133;font-size:28rpx" />
        <view style="width:200rpx;height:60rpx;display:flex;align-items:center;justify-content:center" class="voider-button">按钮</view>
      </view>
      <scroll-view scroll-y="true" enhanced="true" show-scrollbar="false" enable-flex="true" style="width:100%;height:100%;padding:16rpx;position:absolute;bottom:0;top:0rpx;bottom:80rpx;display:flex;flex-direction:column">
        <view wx:for="{{messageList}}" wx:for-item="item" wx:for-index="index" wx:key="index" style="width:100%;height:auto;padding:16rpx;flex-shrink:0;display:flex;flex-direction:row;justify-content:flex-end">
          <view style="width:auto;height:auto;padding-left:20rpx;padding-right:20rpx;padding-top:10rpx;padding-bottom:10rpx;margin-left:60rpx;margin-right:20rpx;margin-top:20rpx;background:#409eff;border-radius:10rpx;display:flex;flex-direction:column">
            <text style="width:auto;height:auto;color:#ffffff;font-size:28rpx;flex-shrink:0">{{item.content}}</text>
          </view>
          <image src="" mode="aspectFill" style="width:80rpx;height:80rpx;border-radius:200rpx" />
        </view>
      </scroll-view>
    </view>
  </view>
</view>
